wildcard_constraints:
    pseudorep=r"pseudorep(1|2)",

rule all:
    input:
        # fastp
        expand("results/fastp/{sample}.ok", sample=SAMPLES),
       
        # bowtie2-build
        "results/bowtie2_build/reference.ok",

        # bowtie2-align
        expand("results/bowtie2_align/{sample}.ok", sample=SAMPLES),

        # PBC QC
        expand("results/pbc_qc/{sample}.ok", sample=SAMPLES),

        # Filtering
        expand("results/filter/{sample}.ok", sample=SAMPLES),

        # BEDPE & tagAlign
        expand("results/bedpe_tagalign/{sample}.ok", sample=SAMPLES),

        # MACS3 signal bedGraph
        expand("results/macs3_signal/{sample}.ok", sample=SAMPLES),

        # bigtools bedgraphtobigwig
        expand("results/macs3_signal/{sample}.bedgraphtobigwig.ok", sample=SAMPLES),

        # fold change signal
        expand("results/macs3_fold_change_signal/{sample}.ok", sample=SAMPLES),

        # pvalue signal
        expand("results/macs3_pvalue_signal/{sample}.ok", sample=SAMPLES),

        # MACS3 callpeak
        expand("results/macs3_callpeak/{sample}.ok", sample=SAMPLES),

        # fragment length QC 
        expand("results/frag_len/{sample}.ok", sample=SAMPLES),

        # QC: TSS enrichment
        expand("results/tss_enrichment/{sample}.ok", sample=SAMPLES),

        # QC: FRiP
        expand("results/frip_all/{sample}.ok", sample=SAMPLES),

        # Pseudoreplicates & IDR
        expand("results/pseudoreps/{sample}.ok", sample=SAMPLES),
        
        # MACS3 callpeak pseudoreps
        expand("results/macs3_pseudoreps/{sample}.{pseudorep}.ok", sample=SAMPLES, pseudorep=["pseudorep1","pseudorep2"]),
        
        # IDR
        expand("results/idr/{sample}.ok", sample=SAMPLES),

        # Overlap peaks
        expand("results/overlap_peaks/{sample}.ok", sample=SAMPLES),
        
        # Overlap peaks (ABC method) 
        expand("results/overlap_peaks_abc/{sample}.ok", sample=SAMPLES),

        # # WIP
