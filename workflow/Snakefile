configfile: "config/config.yml"

if config["input"].get("slack_webhook_url"):
  URL=config["input"]["slack_webhook_url"]
  onstart:
    shell("curl -X POST -H \"Content-Type: application/json\" -d '{{\"text\":\"Snakemake Started 🚀\"}}' {URL}")
  onsuccess:
    shell("curl -X POST -H \"Content-Type: application/json\" -d '{{\"text\":\"Snakemake Finished Successfully! ✅\"}}' {URL}")
  onerror:
    shell("curl -X POST -H \"Content-Type: application/json\" -d '{{\"text\":\"Snakemake Finished With Errors! ❌\"}}' {URL}")

