samples: config/samples.tsv
outdir: results
pixi_env: default
run_id: default          # outputs go under results/<run_id>/; override per run
mito_chr_name: chrM
tmp_dir: .tmp            # samtools sort and IDR scratch; /tmp may be mounted noexec

references:
  fasta: resources/GRCh38_no_alt_analysis_set_GCA_000001405.15.fasta
  tss: resources/ENCFF493CCB.bed.gz
  blacklist: resources/ENCFF356LFX.bed.gz
  dhs: resources/ENCFF304XEX.bed.gz
  promoters: resources/ENCFF140XLU.bed.gz
  enhancers: resources/ENCFF212UAV.bed.gz
  anchors: resources/GRCh38-Anchors.bed

params:
  multimapping: 4        # alignments a read may have; bowtie2 runs with -k multimapping+1
  pval_thresh: 0.01       # MACS3 p-value cutoff
  cap_num_peak: 300000    # peaks kept per call, by p-value
  smooth_win: 150         # MACS3 --extsize; --shift is minus half
  idr_thresh: 0.05
