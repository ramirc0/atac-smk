import os

from dotenv import load_dotenv


include: "rules/common.smk"
include: "rules/preprocess.smk"
include: "rules/signal.smk"
include: "rules/peaks.smk"
include: "rules/qc.smk"


# The Slack webhook URL may come from a .env file in the working directory.
load_dotenv()
SLACK_WEBHOOK_URL = os.environ.get("SLACK_WEBHOOK_URL")


def notify_slack(text):
    """Post a message to the Slack webhook.

    Parameters
    ----------
    text : str
        Message text.
    """
    payload = f'{{"text":"{text}"}}'
    shell(
        "curl -X POST -H 'Content-Type: application/json' -d {payload:q} {SLACK_WEBHOOK_URL:q}"
    )


if SLACK_WEBHOOK_URL:
    print("SLACK_WEBHOOK_URL found")

    onstart:
        notify_slack("Snakemake Started 🚀")

    onsuccess:
        notify_slack("Snakemake Finished Successfully! ✅")

    onerror:
        notify_slack("Snakemake Finished With Errors! ❌")

else:
    print("SLACK_WEBHOOK_URL not found")


